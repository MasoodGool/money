{
    // ------------------------------------------------------------------
    // HARD INVARIANT: dry_run is true, permanently. This system generates
    // signals for manual execution only — it never trades. Any change
    // setting dry_run to false is a bug, not a feature request.
    // ------------------------------------------------------------------
    "dry_run": true,
    "dry_run_wallet": 1000,

    "strategy": "BaselineTrendV2",

    "trading_mode": "spot",
    "margin_mode": "",
    "max_open_trades": 3,
    "stake_currency": "USDT",
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 0.99,
    "fiat_display_currency": "ZAR",

    "cancel_open_orders_on_exit": false,

    "db_url": "sqlite:////freqtrade/user_data/db/tradesv3.dryrun.sqlite",

    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },

    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },

    "exchange": {
        "name": "binance",
        // freqtrade keys stay EMPTY, permanently. freqtrade is the signal
        // generator only and runs dry-run on public market data — it never
        // authenticates to trade. The trade-permission key lives in the
        // Concierge, which is what actually places orders.
        "key": "",
        "secret": "",
        "ccxt_config": {},
        "ccxt_async_config": {},
        "pair_whitelist": [
            "BTC/USDT",
            "ETH/USDT",
            "SOL/USDT",
            "BNB/USDT",
            "XRP/USDT",
            "ADA/USDT",
            "AVAX/USDT",
            "LINK/USDT",
            "LTC/USDT",
            "DOT/USDT",
            "DOGE/USDT",
            "ATOM/USDT"
        ],
        "pair_blacklist": []
    },

    "pairlists": [
        {"method": "StaticPairList"}
    ],

    // Entry/exit signals route to the Concierge, which sizes the position
    // and auto-executes on Binance. Retries so a transient Concierge hiccup
    // does not silently drop a signal.
    "webhook": {
        "enabled": true,
        "url": "http://concierge:3000/signal",
        "format": "json",
        "retries": 3,
        "retry_delay": 2,
        "entry": {
            "type": "entry",
            "trade_id": "{trade_id}",
            "exchange": "{exchange}",
            "pair": "{pair}",
            "direction": "{direction}",
            "open_rate": "{open_rate}",
            "amount": "{amount}",
            "stake_amount": "{stake_amount}",
            "stake_currency": "{stake_currency}",
            "current_rate": "{current_rate}",
            "enter_tag": "{enter_tag}",
            "open_date": "{open_date}"
        },
        "entry_cancel": {
            "type": "entry_cancel",
            "trade_id": "{trade_id}",
            "pair": "{pair}",
            "open_rate": "{open_rate}",
            "current_rate": "{current_rate}"
        },
        "entry_fill": {
            "type": "entry_fill",
            "trade_id": "{trade_id}",
            "pair": "{pair}",
            "open_rate": "{open_rate}",
            "amount": "{amount}",
            "open_date": "{open_date}"
        },
        "exit": {
            "type": "exit",
            "trade_id": "{trade_id}",
            "pair": "{pair}",
            "gain": "{gain}",
            "amount": "{amount}",
            "open_rate": "{open_rate}",
            "current_rate": "{current_rate}",
            "profit_amount": "{profit_amount}",
            "profit_ratio": "{profit_ratio}",
            "stake_currency": "{stake_currency}",
            "exit_reason": "{exit_reason}",
            "open_date": "{open_date}",
            "close_date": "{close_date}"
        },
        "exit_cancel": {
            "type": "exit_cancel",
            "trade_id": "{trade_id}",
            "pair": "{pair}",
            "exit_reason": "{exit_reason}"
        },
        "exit_fill": {
            "type": "exit_fill",
            "trade_id": "{trade_id}",
            "pair": "{pair}",
            "close_rate": "{close_rate}",
            "amount": "{amount}",
            "profit_amount": "{profit_amount}",
            "profit_ratio": "{profit_ratio}",
            "exit_reason": "{exit_reason}",
            "close_date": "{close_date}"
        },
        "status": {
            "type": "status",
            "status": "{status}"
        }
    },

    // Freqtrade-native Telegram is wired in Phase 2 for daily summaries
    // and bot-health messages only. Tickets go through the Concierge.
    "telegram": {
        "enabled": false,
        "token": "",
        "chat_id": ""
    },

    // FreqUI / REST API arrives in Phase 4, tunnel-only. Disabled until then.
    "api_server": {
        "enabled": false,
        "listen_ip_address": "127.0.0.1",
        "listen_port": 8080,
        "username": "",
        "password": ""
    },

    "initial_state": "running",
    "internals": {
        "process_throttle_secs": 5
    }
}
