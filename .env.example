# Copy to .env (chmod 600) on the deployment VM. NEVER commit .env.

# --- Binance ---
# AUTO-EXECUTION: the Concierge places real orders, so this key needs
# "Enable Spot & Margin Trading". WITHDRAWAL MUST STAY DISABLED. Always.
# IP-restrict the key to this host. Use a TESTNET key while BINANCE_TESTNET=1
# (create one at https://testnet.binance.vision), and only swap in a mainnet
# key once a strategy has cleared the Phase 1 graduation bar.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Spot testnet (fake balances) vs real-money mainnet. Defaults to testnet.
# Set to 0/false ONLY to trade real funds — this is the live-money switch.
BINANCE_TESTNET=1

# Master cut-off. While "1"/true the Concierge places NO orders (notify-only).
# Set to 0/false to ARM auto-execution. Defaults to on so nothing trades by
# accident on a fresh deploy.
KILL_SWITCH=1

# --- Risk layer (sizing + circuit breakers) ---
RISK_EQUITY=1000              # account equity in USDT used for sizing
RISK_PER_TRADE=0.01           # 1% max loss to stop, per trade
RISK_MAX_POSITION_PCT=0.20    # hard cap: 20% of equity per position
RISK_DAILY_LOSS_LIMIT=0.03    # suppress entries after 3% realized daily loss
RISK_STOP_LOSS_PCT=0.05       # protective stop distance from entry
RISK_STOP_LIMIT_OFFSET_PCT=0.005  # stop-limit sits this far below the trigger
RISK_TAKE_PROFIT_PCT=0.08     # take-profit distance from entry

# --- Telegram (Phase 2+) ---
# Bot used by the Concierge for trade tickets and journal commands.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Monitoring (Phase 4) ---
SENTRY_DSN=

# --- Concierge ---
CONCIERGE_PORT=3000
