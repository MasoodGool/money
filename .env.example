# Copy to .env (chmod 600) on the deployment VM. NEVER commit .env.

# --- Binance ---
# HARD INVARIANT: this key must be READ-ONLY (market data + account/trade
# history reads). No trade permission. No withdrawal permission. Ever.
# Restrict it to the deployment VM's static IP in the Binance key settings.
# Phase 0 does not need it at all — dry-run uses public market data.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Telegram (Phase 2+) ---
# Bot used by the Concierge for trade tickets and journal commands.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Monitoring (Phase 4) ---
SENTRY_DSN=

# --- Concierge ---
CONCIERGE_PORT=3000
