# Copy to .env (chmod 600) on the deployment VM. NEVER commit .env.

# --- Binance ---
# AUTO-EXECUTION: the Concierge places real orders, so this key needs
# "Enable Spot & Margin Trading". WITHDRAWAL MUST STAY DISABLED. Always.
# IP-restrict the key to this host. Use a TESTNET key while BINANCE_TESTNET=1
# (create one at https://testnet.binance.vision), and only swap in a mainnet
# key once a strategy has cleared the Phase 1 graduation bar.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Spot testnet (fake balances) vs real-money mainnet. Defaults to testnet.
# Set to 0/false ONLY to trade real funds — this is the live-money switch.
BINANCE_TESTNET=1

# Master cut-off. While "1"/true the Concierge places NO orders (notify-only).
# Set to 0/false to ARM auto-execution. Defaults to on so nothing trades by
# accident on a fresh deploy.
KILL_SWITCH=1

# --- Risk layer (sizing + circuit breakers) ---
RISK_EQUITY=1000              # account equity in USDT used for sizing
RISK_PER_TRADE=0.01           # 1% max loss to stop, per trade
RISK_MAX_POSITION_PCT=0.20    # hard cap: 20% of equity per position
RISK_DAILY_LOSS_LIMIT=0.03    # suppress entries after 3% realized daily loss
RISK_STOP_LOSS_PCT=0.05       # protective stop distance from entry
RISK_STOP_LIMIT_OFFSET_PCT=0.005  # stop-limit sits this far below the trigger
RISK_TAKE_PROFIT_PCT=0.08     # take-profit distance from entry

# --- Tweet signal source (PRIMARY) ---
# The account whose calls drive the bot. Without a leading @.
TWEET_HANDLE=TradexWhisperer

# X (Twitter) API v2 app bearer token.
# ⚠️ Reading a user's timeline (GET /2/users/:id/tweets) is NOT available on
# the free tier — you need a paid X API plan (Basic or above). With no token
# the tweet feed stays OFF and the Concierge says so loudly at boot; it does
# not silently pretend the account went quiet.
X_BEARER_TOKEN=

# Anthropic API key — the analyst that classifies each tweet into a signal.
ANTHROPIC_API_KEY=
TWEET_ANALYST_MODEL=claude-opus-5

TWEET_SIGNALS_ENABLED=1       # master switch for the feed itself
TWEET_POLL_SECONDS=60         # how often to check for new tweets
TWEET_BACKFILL_DAYS=30        # window for `npm run backfill:tweets` (analysis only)

# Assets we are willing to trade from a tweet. A call on anything else is
# recorded and ignored — this caps the damage a misread tweet can do, so
# widen it deliberately, never casually.
TWEET_ASSETS=BTC,ETH,SOL

# Entry quality gates (exits deliberately bypass these — closing risk should
# never be blocked by a hedged-sounding tweet).
TWEET_MIN_CONFIDENCE=0.75     # analyst confidence in its reading, 0..1
TWEET_MIN_CONVICTION=medium   # low | medium | high
TWEET_MAX_AGE_MINUTES=30      # never chase a stale call
TWEET_ALLOW_SPECULATIVE=0     # 1 to act on "this could run" musings too

# --- Telegram (notify-only alerts) ---
# Create a bot via @BotFther to get the token; send it a message, then read
# your chat id from https://api.telegram.org/bot<token>/getUpdates.
# When both are set the Concierge sends alerts to Telegram; when either is
# blank it logs alerts to stdout instead (alerts are never silently lost).
# These are outbound notifications only — they do not place or confirm orders.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Monitoring (Phase 4) ---
SENTRY_DSN=

# --- Concierge ---
CONCIERGE_PORT=3000
TWEET_DB_PATH=concierge-tweets.sqlite   # audit log: every tweet + classification

# --- Production only (docker-compose.prod.yml) ---
# freqtrade is OPTIONAL now (research/backtesting profile only) — the tweet
# feed is the signal source. These apply if you run `--profile freqtrade`.
# freqtrade's OWN Telegram bot for daily summaries / health (separate from the
# Concierge execution alerts above; can be the same bot+chat if you prefer).
FT_TELEGRAM_TOKEN=
FT_TELEGRAM_CHAT_ID=

# FreqUI (loopback only, via SSH tunnel). Set a strong password; generate the
# secrets with e.g. `openssl rand -hex 32`.
FREQUI_PASSWORD=
FREQUI_JWT_SECRET=
FREQUI_WS_TOKEN=
